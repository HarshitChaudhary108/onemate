# Exa API key (backend only, never NEXT_PUBLIC_*). Blank = not configured.
EXA_API_KEY=
# Exa mode: "live" calls the real API; "mock" uses disclosed synthetic sample
# data for tests/demos. Missing key never enables mock implicitly.
EXA_MODE=live
# MoltSets API key (backend only). Blank = not configured.
MOLTSETS_API_KEY=
# MoltSets mode: "live" | "mock" (disclosed sample data) | "off" (disabled).
MOLTSETS_MODE=live
# Truthful User-Agent sent on every MoltSets request.
MOLTSETS_USER_AGENT=outmate-prototype/1.0
# Comma-separated CORS allowlist for frontend origins. Never "*".
CORS_ORIGINS=http://localhost:3000
# Groq API key for the sheets planner (backend only). Blank = not configured.
GROQ_API_KEY=__
# Groq mode: "live" calls the real API; "mock" uses deterministic synthetic plans.
GROQ_MODE=live
# Planner model on Groq Chat Completions (needs strict JSON Schema support).
PLANNER_MODEL=openai/gpt-oss-120b
# SQLite file for sheets persistence. Relative to the backend working dir.
SHEETS_DB_PATH=sheets.db
# Maximum rows per sheet.
SHEET_MAX_ROWS=200
# Maximum columns per sheet.
SHEET_MAX_COLUMNS=30
# Maximum concurrent cell executions.
SHEET_MAX_CONCURRENCY=4
# Exa API requests-per-second cap.
EXA_MAX_QPS=5
# Hard per-run spend cap in USD, from provider-reported cost.
RUN_COST_CAP_USD=1.00
# HubSpot OAuth app client id (backend only). Blank = not configured.
HUBSPOT_CLIENT_ID=
# HubSpot OAuth app client secret (backend only, never logged). Blank = not configured.
HUBSPOT_CLIENT_SECRET=
# OAuth redirect URI registered on the HubSpot app — must match exactly.
HUBSPOT_REDIRECT_URI=http://localhost:8000/api/integrations/hubspot/callback
# Space-separated OAuth scopes requested at connect time.
HUBSPOT_SCOPES=crm.objects.companies.read crm.objects.companies.write crm.objects.contacts.read crm.objects.contacts.write crm.schemas.companies.write
# Fernet key (urlsafe base64, 32 bytes) encrypting stored OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank = not configured.
HUBSPOT_TOKEN_KEY=
# HubSpot mode: "live" calls the real API; "mock" uses a disclosed in-memory
# portal; "off" disables the integration. Missing config never enables mock.
HUBSPOT_MODE=live
# Frontend URL the OAuth callback redirects to after connect.
HUBSPOT_POST_CONNECT_URL=http://localhost:3000/integrations
# HubSpot API requests-per-second cap.
HUBSPOT_MAX_QPS=5
